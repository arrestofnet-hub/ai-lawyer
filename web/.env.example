# WEB PILOT — set in server secret manager, never commit actual values.
PORT=8791
HOST=127.0.0.1
PUBLIC_ORIGIN=https://ailawyer.kz
DATA_DIR=/var/lib/ai-lawyer-web
# Generate DATA_KEY with: openssl rand -hex 32
DATA_KEY=
# Create an API key in your own OpenAI API account (billed separately)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
SIGNUP_INVITE_CODE=
MAX_MESSAGES_PER_DAY=25
# Guest budget protection: 10 replies per browser, 12 API attempts per IP/30 days,
# and 40 guest API attempts per 24 hours site-wide (conservative pilot defaults).
# Reducing these values can block visitors on shared Wi-Fi or corporate networks.
GUEST_CHAT_ENABLED=1
GUEST_IP_30D_MAX=12
GUEST_GLOBAL_24H_MAX=40
ENABLE_LAW_SEARCH=1
SECOND_PASS_ENABLED=1

# Email registration: off until SMTP is configured. Existing invite-only registration stays active.
# Use a dedicated domain mailbox (for example no-reply@ailawyer.kz).
# Never commit SMTP passwords. Enter them in /etc/ai-lawyer-web.env via an SSH root shell.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sign-In: off until both Google OAuth Web client credentials are set.
# In Google Cloud authorized redirect URI must be exactly:
# https://ailawyer.kz/chat/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# After Google is configured, allow new Google-created accounts only if set to 1.
GOOGLE_SIGNUP_ENABLED=0

# Remember me is a 30-day HttpOnly cookie; otherwise browser-session cookie and 24h server expiry.
# Browser password manager controls storage of the password; the app never puts it in localStorage.
