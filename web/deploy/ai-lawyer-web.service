[Unit]
Description=AI Lawyer Kazakhstan standalone web pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/ai-lawyer-web/web
EnvironmentFile=/etc/ai-lawyer-web.env
ExecStart=/usr/bin/node /opt/ai-lawyer-web/web/server.mjs
StateDirectory=ai-lawyer-web
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-lawyer-web
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
